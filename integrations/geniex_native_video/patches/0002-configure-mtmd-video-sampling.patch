@@ -949,0 +951,18 @@ mtmd_helper_video_init_params mtmd_helper_video_init_params_default() {
+
+    if (const char * value = std::getenv("MTMD_VIDEO_FPS")) {
+        float parsed = 0.0f;
+        char  trailing = '\0';
+        if (sscanf(value, "%f%c", &parsed, &trailing) == 1 && parsed > 0.0f) {
+            params.fps_target = parsed;
